SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI remains required for the existing retrieval embeddings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4.1-mini

# Mistral is the default text-generation provider for this MVP.
MISTRAL_API_KEY=
MISTRAL_GENERATION_MODEL=ministral-3b-latest
EDUCATION_AI_MISTRAL_ENABLED=true
EDUCATION_AI_MISTRAL_GENERATION_ENABLED=true
EDUCATION_AI_DEFAULT_PROVIDER=mistral
EDUCATION_AI_FALLBACK_PROVIDER=openai

ASKCI_OPENAI_ENABLED=true
ASKCI_OPENAI_GENERATION_ENABLED=true
ASKCI_OPENAI_QUALITY_ENABLED=true
ASKCI_CLAUDE_ENABLED=false
